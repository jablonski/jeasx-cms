{
  "name": "jeasx-cms",
  "type": "module",
  "scripts": {
    "start": "jeasx start",
    "build": "jeasx build",
    "dev": "jeasx dev",
    "clean": "jeasx clean",
    "tscheck": "tsc -p . --noEmit",
    "test": "npm run -s bundle -- test/*.test.ts && node --test .build/*.test.js",
    "seed": "npm run -s bundle -- seed/seed.ts && node .build/seed.js",
    "bundle": "esbuild --bundle --alias:@cms=./src/@cms --platform=node --format=esm --packages=external --log-level=warning --outdir=.build"
  },
  "dependencies": {
    "jeasx": "3.0.2"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true
  }
}
